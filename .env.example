# KR Market Package Environment Configuration Template
# Copy this file to .env and fill in your API keys

# ==========================================
# 1. AI Analysis (Required for LLM features)
# ==========================================
# Google Gemini API Key (Required)
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API Key (Primary text analysis, including decisive analysis)
# Create/manage keys in the DeepSeek platform console. Never commit a real key.
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible DeepSeek endpoint override. Leave this line
# commented to use the application's credential-free default endpoint.
# DEEPSEEK_BASE_URL=

# OpenAI API Key (Optional fallback when the primary provider fails)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional routing model IDs. Blank values use the application's tier-safe
# defaults; deployments may pin model IDs verified by the live health check.
AI_DEEPSEEK_FAST_MODEL=
AI_DEEPSEEK_DECISIVE_MODEL=
AI_OPENAI_FALLBACK_MODEL=
AI_GEMINI_VISION_MODEL=

# Disabled by default. Set only to an exact model whose separate Vision
# capability attestation passes the central health policy.
AI_DEEPSEEK_VISION_MODEL=

# Optional positive USD hard cap for automatic OpenAI fallback per UTC day.
AI_OPENAI_DAILY_BUDGET_USD=

# ==========================================
# 2. Notifications (Optional)
# ==========================================
# Discord Webhook URL for alerts
DISCORD_WEBHOOK_URL=

# ==========================================
# 3. System Settings
# ==========================================
# Required in production. Generate a long random value; changing it invalidates
# existing Bearer tokens.
SECRET_KEY=

# Fresh-database bootstrap only. Set a separate random value, send it once as
# X-Bootstrap-Admin-Secret for the first registration, then remove it.
MARKETFLOW_BOOTSTRAP_ADMIN_SECRET=

# Optional comma-separated reverse-proxy origin IPs. Loopback is trusted by
# default for the local Cloudflare Tunnel process.
TRUSTED_PROXY_IPS=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Project Root Directory (Optional, defaults to current dir)
# KR_MARKET_DIR=

# ==========================================
# 4. Auto-generated inventory of every env var referenced in code (2026-09-02)
# ==========================================
# 리뷰 결과 코드가 참조하는 변수 256개 중 250개가 이 파일에 없었다. 아래는 이름·참조 위치만
# 나열한 목록이다 (기본값은 코드의 os.getenv 두번째 인자 참고). 필요한 것만 주석을 풀어 사용.
# 재생성: scripts/gen_env_inventory.py

