    "tier": "deep",
    "severity": "standard",
    "pages": [
     "/admin/control-center"
    ],
    "label": "관제 요약",
    "readonly_audited": true,
    "expect_keys": [
     "schema",
     "monitor",
     "counts"
    ]
   },
   {
    "path": "/api/admin/control-center/incidents",
    "auth": "admin",
    "tier": "deep",
    "severity": "standard",
    "pages": [
     "/admin/control-center"
    ],
    "label": "관제 사건",
    "readonly_audited": true,
    "expect_keys": [
     "state",
     "incidents"
    ]
   },
   {
    "path": "/api/admin/control-center/routes",
    "auth": "admin",
    "tier": "deep",
    "severity": "standard",
    "pages": [
     "/admin/control-center"
    ],
    "label": "경로 목록",
    "readonly_audited": true,
    "expect_keys": [
     "totals",
     "routes"
    ]
   }
  ],
  "auth_probe_safe": [
   "/api/admin/control-center/summary",
   "/api/admin/control-center/incidents",
   "/api/admin/control-center/routes"
  ],
  "public_probe_safe": [
   "/healthz",
   "/api/health"
  ]
 },
