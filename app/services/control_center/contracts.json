   "MarketFlow-Flask",
   "MarketFlow-Scheduler",
   "MarketFlow-Flask-Watchdog",
   "MarketFlow-Scheduler-Watchdog",
   "MarketFlow-Tunnel-Watchdog",
   "MarketFlow-ControlCenter-Fast",
   "MarketFlow-ControlCenter-Standard",
   "MarketFlow-ControlCenter-Deep"
  ],
  "resident": [
   "MarketFlow-Flask",
   "Goodrich-TradingOS"
  ],
  "ignore": [
   "MarketFlow-Watchdog"
  ]
 },
