# ─────────────────────────────────────────────────────────────
# Marketing Studio 환경 설정  (복사: copy .env.example .env)
# 비밀 키는 절대 git 에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# 서버
STUDIO_HOST=127.0.0.1
STUDIO_PORT=5080

# ── LLM (하나만 있어도 동작, 없으면 템플릿 모드로 동작) ──
# 우선순위 (쉼표 구분): gemini, deepseek, openai, anthropic
STUDIO_LLM_ORDER=gemini,deepseek,openai,anthropic
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 모델명 (MarketFlow 와 동일 값 사용 가능)
STUDIO_GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
STUDIO_OPENAI_MODEL=gpt-5.5
STUDIO_ANTHROPIC_MODEL=claude-sonnet-5

# ── 네이버 키워드 도구 (선택: 검색량 기반 키워드 정렬) ──
# 네이버 검색광고 API  https://manage.searchad.naver.com  → 도구 → API 관리
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET=
NAVER_SEARCHAD_CUSTOMER_ID=
# 네이버 개발자센터 (데이터랩 검색어 트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 브랜드커넥트 크롤링 ──
STUDIO_BRANDCONNECT_URL=https://brandconnect.naver.com/
STUDIO_HEADLESS=1
# 크로미움 실행 파일 경로 (비우면 playwright 기본 브라우저)
STUDIO_CHROMIUM_PATH=

# ── 영상 제작 ──
# ffmpeg 경로 (비우면 PATH → imageio-ffmpeg 내장 바이너리 순으로 자동 탐색)
STUDIO_FFMPEG=
STUDIO_TTS_VOICE=ko-KR-SunHiNeural
STUDIO_TTS_RATE=+5%
# 한글 폰트 경로 (비우면 자동 탐색: 맑은고딕/나눔고딕/Noto CJK)
STUDIO_FONT_PATH=

# ── 콘텐츠 기본값 ──
STUDIO_BLOG_TONE=친근하고 솔직한
STUDIO_BLOG_LENGTH=2000
STUDIO_DISCLOSURE=이 포스팅은 네이버 브랜드커넥트 제휴 마케팅 활동의 일환으로, 링크를 통해 구매 시 일정 수수료를 제공받을 수 있습니다.
STUDIO_CREATOR_NAME=
